{
  "name": "34.mongodb-viewer",
  "version": "1.0.0",
  "description": "MongoDB Viewer with dynamic connection and document exploration",
  "main": "backend.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "start": "node backend.js",
    "dev": "nodemon backend.js",
    "frontend:dev": "cd frontend && npm run dev",
    "frontend:build": "cd frontend && npm run build",
    "frontend:start": "cd frontend && npm run start",
    "install:all": "npm install && cd frontend && npm install",
    "dev:full": "concurrently \"npm run dev\" \"npm run frontend:dev\"",
    "build:full": "npm run frontend:build",
    "start:full": "concurrently \"npm run start\" \"npm run frontend:start\"",
    "clean": "rm -rf frontend/.next frontend/out",
    "reset": "npm run clean && npm run install:all",
    "lint": "cd frontend && npm run lint",
    "lint:fix": "cd frontend && npm run lint -- --fix"
  },
  "keywords": ["mongodb", "viewer", "database", "explorer"],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "mongodb": "^6.17.0"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "nodemon": "^3.1.0"
  }
}
