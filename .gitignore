# Python Cache and Virtual Environment
# Contains compiled bytecode files generated by Python to speed up loading modules
__pycache__/
# Directory for Python virtual environment, containing dependencies and packages
venv/

# Environment Variables
# File to store sensitive information like API keys
.env

# Temporary and Processed Files
# Directory for temporarily storing uploaded files before processing
temp_uploads/
# Directory for storing processed content from documents
content/
# Directory for storing figures and images related to the project
figures/
# Directory for storing project documentation files
docs/

# Document and Index Files
# Pattern to ignore all PDF files in the project
**/*.pdf
# Pattern to ignore all files with .pkl extension, typically used for serializing Python objects
*.pkl
# Pattern to ignore all files with .faiss extension, used for FAISS index files
*.faiss
