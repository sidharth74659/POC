{
  "name": "backend",
  "version": "0.1.0",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "test": "node test-server.js",
    "lint": "eslint ./src --ext .js",
    "lint:fix": "eslint ./src --ext .js --fix",
    "format": "prettier --write \"src/**/*.js\"",
    "format:fix": "prettier --write \"src/**/*.js\" --fix",
    "dev": "concurrently \"cd ../angular-app && npm run build:watch\" \"nodemon src/server.js\""
    },
  "dependencies": {
    "axios": "^1.11.0",
    "bcrypt": "^6.0.0",
    "cloudflare": "^4.5.0",
    "dotenv": "^17.2.0",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.16.4",
    "morgan": "^1.10.1",
    "zod": "^4.0.10"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "eslint": "^9.31.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.3",
    "nodemon": "^3.1.0",
    "prettier": "^3.6.2"
  }
}
