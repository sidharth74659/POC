{
  "watch": ["src", "public"],
  "ext": "ts,js,json,html,css",
  "ignore": ["src/**/*.spec.ts", "src/**/*.test.ts", "dist"],
  "exec": "ts-node --transpile-only src/server.ts --watch",
  "env": {
    "NODE_ENV": "development"
  },
  "delay": "1000",
  "events": {
    "restart": "echo 'Backend server restarted due to changes'"
  }
} 